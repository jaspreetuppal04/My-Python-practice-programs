import pandas as pd

# Create DataFrame
data = {
    "Name": ["Tom", "James", "Ricky", "Steve", "Smith"],
    "Age": [25, 30, 22, 28, 35],
    "Marks": [85, 90, 78, 88, 92]
}

df = pd.DataFrame(data)

print("Original DataFrame")
print(df)


# Access a single column
print("\nName Column")
print(df["Name"])


# Access multiple columns
print("\nName and Marks Columns")
print(df[["Name", "Marks"]])


# Access row using loc
print("\nFirst Row using loc")
print(df.loc[0])


# Access rows using loc
print("\nRows 1 to 3 using loc")
print(df.loc[1:3])

# Access row using iloc
print("\nThird Row using iloc")
print(df.iloc[2])


# Access specific value
print("\nAge of James")
print(df.loc[1, "Age"])


# Access specific rows and columns
print("\nRows 1 to 3 and Name, Marks columns")
print(df.loc[1:3, ["Name", "Marks"]])


# Using iloc with row and column numbers
print("\nRows 0 to 2 and Columns 0 to 1")
print(df.iloc[0:3, 0:2])